# Copy to .env (never commit .env). Read by BOTH docker compose and NestJS.

# --- PostgreSQL (container + app credentials) ---
POSTGRES_DB=bhorsha
POSTGRES_USER=bhorsha
POSTGRES_PASSWORD=bhorsha_local_dev_pw

# --- How NestJS reaches the database ---
# Backend on your machine (npm run start:dev): localhost + 5433 (the published port).
# Backend inside docker compose later:          DB_HOST=db and DB_PORT=5432.
DB_HOST=localhost
DB_PORT=5433
DB_POOL_MAX=10
DB_LOGGING=false

# --- Published image (docker-compose.hub.yml) ---
# Pin a version; avoid :latest so everyone runs the same schema.
DB_IMAGE=siam001/bhorsha-db:2.0.0

# --- pgAdmin (http://localhost:5050) ---
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
